<div class="card">
    <div class="border-top border-bottom">
        <div class="card-body ">
            <div class="container">
                <div class="row">
                    <label class="col-md-6 offset-md-6" for="disabledTextInput">Total {{totalCount}} strokes</label>
                </div>
            </div>
            <div class="row offset-9">
                <label class="col-3">PageSize</label>
                <select class="col-2 form-control-sm"
                        v-on:change="onPageSizeChange($event)"
                        v-model="pageSize">
                    <option v-for="(data,index) in pageSizeData" :value=data>{{data}}</option>
                </select>
                <label class="col-3">Page</label>
                <select class="col-2 form-control-sm"
                        v-on:change="onPageChange($event)"
                        v-model="page">
                    <option v-for="(data,index) in pageData" :value=data>{{data}}</option>
                </select>
            </div>
        </div>
    </div>
</div>
