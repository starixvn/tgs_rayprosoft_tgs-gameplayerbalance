
<div class="card-body">
    <h5 class="card-title">{{title}}</h5>
    <div class="col-md">
        <div class="form-group row">
            <label class="col-md-2 text-danger" for="disabledTextInput">BrandCode</label>
            <div class="col-md-2">
                <input type="text"
                       class="form-control"
                       placeholder="BrandCode input"
                       v-model="brandCode" />
            </div>
        </div>
        <div class="form-group row">
            <label class="col-md-2 mt-2" >Day</label>
            <div class="col-md-2">
                <select class="select2 form-select shadow-none"
                        style="width: 100%; height: 36px"
                        v-model="state">
                    <option value="">Select</option>
                    <option v-for="(data,index) in stateData" :value=data.value>{{data.key}}</option>
                </select>
            </div>
        </div>
        <div class="border-bottom">
            <div class="card-body">
                <button type="button" class="btn btn-primary" v-on:click="search">
                    Query
                </button>
            </div>
        </div>
    </div>
</div>

<div class="card-body">
    <div class="table-responsive">
        <table id="zero_config"
               class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th v-for="column in tableColumn">{{column}}</th>
                </tr>
            </thead>
            <tbody>
                <tr v-for="(data,index) in tableData">
                    <td>{{index+1 }}</td>
                    <td>{{data.id }}</td>
                    <td>{{data.gameProviderCode }}</td>
                    <td>{{stateString(data.state) }}</td>
                    <td>{{localtime(data.createdOn)}}</td>
                    <td>{{localtime(data.startOn)}}</td>
                    <td>{{localtime(data.endOn)}}</td>
                </tr>
                <tr v-show="showNoData">
                    <td align="center" :colspan="tableColumn.length">No Data</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@section Script{
    <script type="text/javascript">
        const App = {
            data() {
                return {
                    title: "Brand Form",
                    tableColumn: ["No.", "遊戲廠商", "狀態", "創建時間", "處理起始", "處理結束"],
                    tableData: [],
                    brandData: [],
                    brandCode: "",
                    stateData: [],
                    state: "",
                    playerCode: "",
                    username: "",
                    pageData: [1],
                    pageSize: 10
                }
            },
            mounted() {
                this.initState();
            },
            methods: {
                localday(time) {

                    return moment.utc(time).local().format("yyyy-MM-DD");
                },
                localtime(time) {

                    return moment.utc(time).local().format("yyyy-MM-DD HH:mm:ss");
                },
                initState() {
                    axios
                        .get(
                            'api/brandforms/state')
                        .then(response => {
                            this.stateData = response.data;
                        })
                        .catch(function (error) { // 请求失败处理
                            console.log(error);
                        })
                },
                initSearch() {
                    this.loadData();

                },
                loadData() {
                    this.tableData = [];
                    this.showNoData = true;
                    if (this.brandCode == "") {
                        return;
                    }
                    axios
                        .get(
                            'api/brandforms',
                            {
                                params: {
                                    brandCode: this.brandCode,
                                    state: this.state,
                                    pageSize: this.pageSize

                                }
                            })
                        .then(response => {
                            console.log(response);
                            this.showNoData = response.data.totalCount == 0
                            this.tableData = response.data.items;
                        })
                        .catch(function (error) { // 请求失败处理
                            console.log(error);
                        });
                },
                search() {
                    this.page = 1
                    this.loadData();
                },
                onPageSizeChange(event) {
                    this.page = 1
                    this.pageSize = event.target.value;
                    this.loadData();
                },
                onPageChange(event) {
                    this.page = event.target.value;
                    this.loadData();
                },
                stateString(state) {
                    console.log(state);

                    var value = "Queued";
                    switch (state) {
                        case 0:
                            value = "Queued"
                            break;
                        case 1:
                            value = "Processing"
                            break;
                        case 2:
                            value = "Complete"
                            break;
                        case 3:
                            value = "Failed"
                            break;
                    }

                    return value;

                }
            }
        };
        const app = Vue.createApp(App);
        app.use(ElementPlus);
        app.mount("#app");
    </script>
}