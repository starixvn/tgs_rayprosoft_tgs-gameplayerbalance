
<div class="card-body">
    <h5 class="card-title">{{title}}</h5>
    <div class="col-md">
        <div class="form-group row">
            <label class="col-md-2 text-danger" for="disabledTextInput">Id</label>
            <div class="col-md-2">
                <input type="text"
                       class="form-control"
                       placeholder="Id input"
                       v-model="expansionFormId" />
            </div>
        </div>
        <div class="form-group row">
            <label class="col-md-2 mt-2">State</label>
            <div class="col-md-2">
                <select class="select2 form-select shadow-none"
                        style="width: 100%; height: 36px"
                        v-model="state">
                    <option value="">Select</option>
                    <option v-for="(data,index) in stateData" :value=data.value>{{data.key}}</option>
                </select>
            </div>
        </div>
        <div class="form-group row">
            <label class="col-md-2" for="disabledTextInput">Player Code</label>
            <div class="col-md-2">
                <input type="text"
                       class="form-control"
                       placeholder="Player Code input"
                       v-model="playerCode" />
            </div>
        </div>
        <div class="border-bottom">
            <div class="card-body">
                <button type="button" class="btn btn-primary" v-on:click="search">
                    Query
                </button>
            </div>
        </div>
    </div>
</div>

<div class="card-body">
    <div class="table-responsive">
        <table id="zero_config"
               class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th v-for="column in tableColumn">{{column}}</th>
                </tr>
            </thead>
            <tbody>
                <tr v-for="(data,index) in tableData">
                    <td>{{index+1 }}</td>
                    <td>
                        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#exampleModal" v-on:click="result(data.result)">result</button>
                    </td>
                    <td>{{data.id }}</td>
                    <td>{{data.playerCode }}</td>
                    <td>{{data.username }}</td>
                    <td>{{data.gameProviderCode }}</td>
                    <td>{{data.state}}</td>
                    <td>{{localtime(data.createdOn)}}</td>
                    <td>{{localtime(data.startOn)}}</td>
                    <td>{{localtime(data.endOn)}}</td>
                </tr>
                <tr v-show="showNoData">
                    <td align="center" :colspan="tableColumn.length">No Data</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
<partial name="/Views/Shared/_LayoutPagination.cshtml" />

<!-- Modal -->
<div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Result</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form>
                    <pre>{{ jsonstr}}</pre>
                </form>
            </div>
        </div>
    </div>
</div>
@section Script{
    <script type="text/javascript">
        const App = {
            data() {
                return {
                    title: "Excel Player Forms",
                    tableColumn: ["No.", "操作", "訂單號", "用戶代碼", "用戶名", "遊戲廠商", "狀態", "創建時間", "處理起始", "處理結束"],
                    tableData: [],
                    expansionFormId: "",
                    stateData: [],
                    state: "",
                    playerCode: "",
                    pageData: [1],
                    page: 1,
                    pageSizeData: [10, 20, 50, 100, 200],
                    pageSize: 20,
                    showNoData: true,
                    totalCount: 0,
                    totalPage: 1,
                    jsonstr: "{}"
                }
            },
            mounted() {
                this.initState();
                this.initSearch();
            },
            methods: {
                localday(time) {

                    return moment.utc(time).local().format("yyyy-MM-DD");
                },
                localtime(time) {

                    return moment.utc(time).local().format("yyyy-MM-DD HH:mm:ss");
                },
                initState() {
                    axios
                        .get(
                            'api/playerforms/state')
                        .then(response => {
                            this.stateData = response.data;
                        })
                        .catch(function (error) { // 请求失败处理
                            console.log(error);
                        })
                },
                initSearch() {
                    const queryString = window.location.search;
                    const urlParams = new URLSearchParams(queryString);
                    const id = urlParams.get('id')
                    console.log(id);
                    console.log(Boolean(id));
                    if (Boolean(id)) {
                        this.expansionFormId = id;
                    }
                    this.loadData();

                },
                initPage() {
                    this.pageData = [];
                    if (this.totalPage == 0) {
                        this.pageData = [1];
                    } else {
                        for (var i = 0; i < this.totalPage; i++) {
                            this.pageData.push(i + 1);
                        }
                    }
                },
                loadData() {
                    this.tableData = [];
                    this.showNoData = true;
                    if (this.brandCode == "") {
                        return;
                    }
                    axios
                        .get(
                            'api/playerforms/import/' + this.expansionFormId,
                            {
                                params: {
                                    state: this.state,
                                    playerCode: this.playerCode,
                                    pageSize: this.page,
                                    pageSize: this.pageSize

                                }
                            })
                        .then(response => {
                            this.showNoData = response.data.totalCount == 0
                            this.tableData = response.data.items;
                            this.totalCount = response.data.totalCount;
                            this.totalPage = response.data.totalPage;
                            this.initPage();

                        })
                        .catch(function (error) { // 请求失败处理
                            console.log(error);
                        });
                },
                search() {
                    this.page = 1
                    this.loadData();
                },
                result(value) {
                    console.log(value);
                    this.jsonstr = value;
                    var exampleModal = document.getElementById('exampleModal')
                    exampleModal.addEventListener('show.bs.modal', function (event) {
                        // Button that triggered the modal
                        var button = event.relatedTarget
                        // Extract info from data-bs-* attributes
                        var recipient = button.getAttribute('data-bs-whatever')

                    })
                },
                onPageSizeChange(event) {
                    this.page = 1
                    this.pageSize = event.target.value;
                    this.loadData();
                },
                onPageChange(event) {
                    this.page = event.target.value;
                    this.loadData();
                }
            }
        };
        const app = Vue.createApp(App);
        app.use(ElementPlus);
        app.mount("#app");
    </script>
}