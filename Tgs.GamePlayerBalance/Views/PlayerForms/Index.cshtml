
<div class="card-body">
    <h5 class="card-title">{{title}}</h5>
    <div class="col-md">
        <div class="form-group row">
            <label class="col-md-2 text-danger" for="disabledTextInput">PlayerCode</label>
            <div class="col-md-2">
                <input type="text"
                       class="form-control"
                       placeholder="PlayerCode input"
                       v-model="playerCode" />
            </div>
        </div>
        <div class="border-bottom">
            <div class="card-body">
                <button type="button" class="btn btn-primary" v-on:click="search">
                    Query
                </button>
            </div>
        </div>
    </div>
</div>

<div class="card-body">
    <div class="table-responsive">
        <table id="zero_config"
               class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th v-for="column in tableColumn">{{column}}</th>
                </tr>
            </thead>
            <tbody>
                <tr v-for="(data,index) in tableData">
                    <td>{{index+1 }}</td>
                    <td>
                        <button type="button" class="btn btn-outline-info" data-bs-toggle="modal" data-bs-target="#exampleModal" v-on:click="result(data.result)">result</button>
                    </td>
                    <td>{{data.id }}</td>
                    <td>{{data.brandCode}}</td>
                    <td>{{data.gameProviderCode}}</td>
                    <td>{{data.state}}</td>
                    <td>{{localtime(data.createdOn)}}</td>
                    <td>{{localtime(data.startOn)}}</td>
                    <td>{{localtime(data.endOn)}}</td>
                </tr>
                <tr v-show="showNoData">
                    <td align="center" :colspan="tableColumn.length">No Data</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Result</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form>
                    <pre>{{ jsonstr}}</pre>
                </form>
            </div>
        </div>
    </div>
</div>

@section Script{
    <script type="text/javascript">
        const App = {
            data() {
                return {
                    title: "Player Form",
                    tableColumn: ["No.", "操作", "訂單號", "平台", "遊戲供應商", "狀態", "創建時間", "處理起始", "處理結束"],
                    tableData: [],
                    playerCode: "",
                    pageData: [1],
                    pageSize: 10,
                    jsonstr: "{}"
                }
            },
            mounted() {
            },
            filters: {
                pretty: function (value) {
                    console.log(value);
                    return JSON.stringify(JSON.parse(value), null, 2);
                }
            },
            methods: {
                localday(time) {

                    return moment.utc(time).local().format("yyyy-MM-DD");
                },
                localtime(time) {

                    return moment.utc(time).local().format("yyyy-MM-DD HH:mm:ss");
                },
                initSearch() {
                    this.loadData();

                },
                loadData() {
                    this.tableData = [];
                    this.showNoData = true;
                    if (this.playerCode == "") {
                        return;
                    }
                    axios
                        .get(
                            'api/playerforms',
                            {
                                params: {
                                    playerCode: this.playerCode,
                                    state: this.state,
                                    pageSize: this.pageSize

                                }
                            })
                        .then(response => {
                            console.log(response);
                            console.log(response.data);
                            console.log(response.data.length);
                            this.tableData = response.data;
                            this.showNoData = (response.data.length == 0)

                        })
                        .catch(function (error) { // 请求失败处理
                            console.log(error);
                        });
                },
                search() {
                    this.page = 1
                    this.loadData();
                },
                result(value) {
                    this.jsonstr = value;
                },
                onPageSizeChange(event) {
                    this.page = 1
                    this.pageSize = event.target.value;
                    this.loadData();
                },
                onPageChange(event) {
                    this.page = event.target.value;
                    this.loadData();
                }
            }
        };
        const app = Vue.createApp(App);
        app.use(ElementPlus);
        app.mount("#app");
    </script>
}